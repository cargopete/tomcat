# TomCat configuration. Copy to .env and edit, then point the systemd unit at it
# (EnvironmentFile=/home/pi/tomcat/.env). Values shown are the code defaults
# (except TOMCAT_DUTY, noted below); uncomment and change only what you need.
# .env itself is gitignored.

# --- GPIO (BCM numbering) ---
#TOMCAT_PIR_GPIO=17

# --- Hardware PWM channel ---
# The output pin is no longer chosen here: it is fixed by the device-tree
# overlay. `dtoverlay=pwm-2chan` maps PWM0 to GPIO18 (physical pin 12) and
# PWM1 to GPIO19. These select which sysfs chip and channel to drive.
#TOMCAT_PWM_CHIP=0
#TOMCAT_PWM_CHANNEL=0

# --- Ultrasonic drive ---
#TOMCAT_F_LOW_HZ=20000
#TOMCAT_F_HIGH_HZ=24000
#TOMCAT_SWEEP_STEP=250
#TOMCAT_SWEEP_TICK_S=0.020

# Duty cycle, range 0..1000000. 500000 = 50% (full). 250000 = 25% (~6 dB quieter,
# the recommended starting point for week one while you watch the dogs).
#TOMCAT_DUTY=250000

# --- Burst behaviour (seconds) ---
#TOMCAT_BURST_SECONDS=4.0
#TOMCAT_COOLDOWN_S=8.0

# --- Quiet hours (24h clock). Window wraps past midnight; start==end disables. ---
#TOMCAT_QUIET_START_H=22
#TOMCAT_QUIET_END_H=7

# --- Event log location ---
#TOMCAT_DB_PATH=/home/pi/catdeter.sqlite3

# --- The watch (tools/watchdog.py) ---
# How often to sample, in seconds.
#TOMCAT_WATCH_TICK_S=30
# Which unit to watch. tomcat-tone is the sensorless continuous mode.
#TOMCAT_WATCH_UNIT=tomcat-tone
# Where health samples and ledger entries are written.
#TOMCAT_HEALTH_DB=/home/pi/tomcat-health.sqlite3

# Discord webhook for failure notifications. THIS IS A CREDENTIAL: anyone
# holding it can post to your channel. It belongs in .env, which is gitignored,
# and must never be committed. Leave it unset and the watch still records
# everything to SQLite, it just does not shout.
#TOMCAT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# --- The panel (panel/app.py) ---
#TOMCAT_PANEL_PORT=8090
# Bind address. Left unset it uses the Tailscale address, falling back to
# 127.0.0.1. Do not set this to 0.0.0.0.
#TOMCAT_PANEL_HOST=

# --- Night schedule (tools/schedule.py, driven by tomcat-schedule.timer) ---
# The emitter runs nights, because that is when cats come. Window is
# [start, end) on a 24h clock and wraps past midnight. Setting them equal
# disables the schedule and leaves the emitter wherever you last put it.
#TOMCAT_NIGHT_START_H=22
#TOMCAT_NIGHT_END_H=10

# --- Aggressive mode (src/tone_sweep.py, the default) ---
# TOMCAT_MODE=sweep goes back to the original smooth 20-24 kHz triangle.
#TOMCAT_MODE=aggressive
# Band sits lower than the old sweep on purpose: in the blind acoustic trials
# 19 kHz was the strongest detection of any frequency tested and 23 kHz was
# undetectable, so the horn radiates better down here.
#TOMCAT_AGG_LOW_HZ=19000
#TOMCAT_AGG_HIGH_HZ=23000
#TOMCAT_AGG_STEP_HZ=250
# How often the frequency jumps somewhere unpredictable, in seconds.
#TOMCAT_AGG_JUMP_MIN_S=0.015
#TOMCAT_AGG_JUMP_MAX_S=0.045
# Burst and gap lengths. Randomised, because predictability is what drives
# habituation. Short gaps keep on-time near 90 %.
#TOMCAT_AGG_BURST_MIN_S=2.0
#TOMCAT_AGG_BURST_MAX_S=7.0
#TOMCAT_AGG_GAP_MIN_S=0.08
#TOMCAT_AGG_GAP_MAX_S=0.45
# Amplitude gating: rate range, and the fraction of each cycle spent driving.
#TOMCAT_AGG_GATE_MIN_HZ=7
#TOMCAT_AGG_GATE_MAX_HZ=22
#TOMCAT_AGG_GATE_ON=0.92
