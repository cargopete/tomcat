[Unit]
Description=TomCat control panel
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=pi
EnvironmentFile=-/home/pi/tomcat/.env
# Binds to the Tailscale address if there is one, otherwise loopback. It does
# not bind 0.0.0.0: the lever fires an ultrasonic horn into a garden and has no
# business being reachable from the whole LAN.
ExecStart=/usr/bin/python3 /home/pi/tomcat/panel/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
